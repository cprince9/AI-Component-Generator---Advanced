    "prompt": "A modern cryptocurrency portfolio dashboard with 4 KPI stat cards (Total Balance, 24h Profit, Bitcoin price, Ethereum price) with green/red trend indicators and responsive grid.",
    "framework": "html-tailwind",
    "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Modern Crypto Portfolio Dashboard</title>\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <!-- Optional: Configure Tailwind for custom aesthetics if needed, but for a single file, it's often omitted. -->\n    <script>\n        tailwind.config = {\n            theme: {\n                extend: {\n                    colors: {\n                        primary: '#6366F1', // Indigo\n                        secondary: '#A855F7', // Purple\n                        accent: '#22D3EE', // Cyan\n                    }\n                }\n            }\n        }\n    </script>\n    <style>\n        /* Optional custom styles for subtle animations or specific overrides if needed */\n        /* For premium aesthetics, ensuring smooth font rendering across browsers can be nice */\n        body {\n            -webkit-font-smoothing: antialiased;\n            -moz-osx-font-smoothing: grayscale;\n        }\n    </style>\n</head>\n<body class=\"font-sans antialiased text-gray-100 bg-gradient-to-br from-gray-950 via-gray-900 to-black min-h-screen p-6 flex items-center justify-center\">\n\n    <div class=\"w-full max-w-7xl mx-auto py-10\">\n        <h1 class=\"text-5xl font-extrabold text-center mb-16 bg-clip-text text-transparent bg-gradient-to-r from-teal-400 via-blue-400 to-purple-500 tracking-tight leading-tight\">\n            My Crypto Portfolio\n        </h1>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8\">\n\n            <!-- KPI Card 1: Total Balance -->\n            <div class=\"relative flex flex-col justify-between p-7 rounded-3xl overflow-hidden shadow-2xl\n                        bg-white/5 border border-white/10 backdrop-filter backdrop-blur-xl\n                        hover:scale-[1.02] hover:shadow-primary/30 transition-all duration-300 ease-in-out\">\n                <!-- Inner gradient for aesthetic glow -->\n                <div class=\"absolute inset-0 bg-gradient-to-br from-primary/20 via-blue-500/10 to-transparent opacity-30 rounded-3xl -z-10 blur-2xl\"></div>\n                <div class=\"relative z-10\">\n                    <h3 class=\"text-sm uppercase tracking-wider text-gray-400 font-semibold mb-2\">Total Balance</h3>\n                    <p class=\"text-5xl font-extrabold text-white leading-tight mb-4\">$54,321.89</p>\n                    <div class=\"flex items-center text-sm font-medium text-green-400\">\n                        <svg class=\"w-5 h-5 mr-1 text-green-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 10l7-7m0 0l7 7m-7-7v18\"></path></svg>\n                        +3.45%\n                        <span class=\"ml-2 text-gray-500\">(24h)</span>\n                    </div>\n                </div>\n            </div>\n\n            <!-- KPI Card 2: 24h Profit/Loss -->\n            <div class=\"relative flex flex-col justify-between p-7 rounded-3xl overflow-hidden shadow-2xl\n                        bg-white/5 border border-white/10 backdrop-filter backdrop-blur-xl\n                        hover:scale-[1.02] hover:shadow-secondary/30 transition-all duration-300 ease-in-out\">\n                <!-- Inner gradient for aesthetic glow -->\n                <div class=\"absolute inset-0 bg-gradient-to-br from-green-500/20 via-teal-500/10 to-transparent opacity-30 rounded-3xl -z-10 blur-2xl\"></div>\n                <div class=\"relative z-10\">\n                    <h3 class=\"text-sm uppercase tracking-wider text-gray-400 font-semibold mb-2\">24h Profit</h3>\n                    <p class=\"text-5xl font-extrabold text-white leading-tight mb-4\">+$1,876.50</p>\n                    <div class=\"flex items-center text-sm font-medium text-green-400\">\n                        <svg class=\"w-5 h-5 mr-1 text-green-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 10l7-7m0 0l7 7m-7-7v18\"></path></svg>\n                        +3.58%\n                        <span class=\"ml-2 text-gray-500\">(overall)</span>\n                    </div>\n                </div>\n            </div>\n\n            <!-- KPI Card 3: Bitcoin Price -->\n            <div class=\"relative flex flex-col justify-between p-7 rounded-3xl overflow-hidden shadow-2xl\n                        bg-white/5 border border-white/10 backdrop-filter backdrop-blur-xl\n                        hover:scale-[1.02] hover:shadow-yellow-500/30 transition-all duration-300 ease-in-out\">\n                <!-- Inner gradient for aesthetic glow -->\n                <div class=\"absolute inset-0 bg-gradient-to-br from-yellow-500/20 via-orange-500/10 to-transparent opacity-30 rounded-3xl -z-10 blur-2xl\"></div>\n                <div class=\"relative z-10\">\n                    <h3 class=\"text-sm uppercase tracking-wider text-gray-400 font-semibold mb-2\">Bitcoin Price</h3>\n                    <p class=\"text-5xl font-extrabold text-white leading-tight mb-4\">$68,901.23</p>\n                    <div class=\"flex items-center text-sm font-medium text-green-400\">\n                        <svg class=\"w-5 h-5 mr-1 text-green-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 10l7-7m0 0l7 7m-7-7v18\"></path></svg>\n                        +1.23%\n                        <span class=\"ml-2 text-gray-500\">(24h)</span>\n                    </div>\n                </div>\n            </div>\n\n            <!-- KPI Card 4: Ethereum Price -->\n            <div class=\"relative flex flex-col justify-between p-7 rounded-3xl overflow-hidden shadow-2xl\n                        bg-white/5 border border-white/10 backdrop-filter backdrop-blur-xl\n                        hover:scale-[1.02] hover:shadow-indigo-500/30 transition-all duration-300 ease-in-out\">\n                <!-- Inner gradient for aesthetic glow -->\n                <div class=\"absolute inset-0 bg-gradient-to-br from-purple-500/20 via-indigo-500/10 to-transparent opacity-30 rounded-3xl -z-10 blur-2xl\"></div>\n                <div class=\"relative z-10\">\n                    <h3 class=\"text-sm uppercase tracking-wider text-gray-400 font-semibold mb-2\">Ethereum Price</h3>\n                    <p class=\"text-5xl font-extrabold text-white leading-tight mb-4\">$3,456.78</p>\n                    <div class=\"flex items-center text-sm font-medium text-red-400\">\n                        <svg class=\"w-5 h-5 mr-1 text-red-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 14l-7 7m0 0l-7-7m7 7V3\"></path></svg>\n                        -0.87%\n                        <span class=\"ml-2 text-gray-500\">(24h)</span>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </div>\n\n</body>\n</html>",
