    "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Modern Landing Page</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n    <style>\n        @layer base {\n            body {\n                font-family: 'Inter', sans-serif;\n                background: linear-gradient(135deg, #0a0a0a 0%, #171717 100%);\n                background-attachment: fixed;\n                color: #E5E7EB; /* Tailwind's gray-200 */\n                line-height: 1.6;\n            }\n        }\n\n        /* Glassmorphism Effect */\n        .glass-card {\n            background-color: rgba(255, 255, 255, 0.05); /* Subtle white transparent */\n            backdrop-filter: blur(12px) saturate(180%);\n            -webkit-backdrop-filter: blur(12px) saturate(180%);\n            border: 1px solid rgba(255, 255, 255, 0.125); /* Light border for definition */\n            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);\n        }\n        .glass-card:hover {\n            background-color: rgba(255, 255, 255, 0.08); /* Slightly less transparent on hover */\n            border-color: rgba(255, 255, 255, 0.2);\n        }\n\n        /* Gradient Text */\n        .gradient-text {\n            background-image: linear-gradient(to right, #A855F7, #EC4899); /* Purple-500 to Pink-500 */\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text; /* Standard property for completeness */\n            text-fill-color: transparent; /* Standard property for completeness */\n        }\n\n        /* Gradient Button */\n        .gradient-button {\n            background-image: linear-gradient(to right, #A855F7, #EC4899);\n            transition: all 0.3s ease-in-out;\n        }\n        .gradient-button:hover {\n            background-image: linear-gradient(to left, #8B5CF6, #EC4899); /* Subtle reverse on hover */\n            box-shadow: 0 0 25px rgba(168, 85, 247, 0.7); /* Purple glow */\n        }\n\n        /* Glow Hover Effect for cards */\n        .glow-hover:hover {\n            box-shadow: 0 0 25px rgba(168, 85, 247, 0.6), 0 0 50px rgba(236, 72, 153, 0.4); /* Purple and Pink glow */\n        }\n\n        /* Keyframe Animations */\n        @keyframes fadeIn {\n            from { opacity: 0; transform: translateY(20px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        .animate-fade-in {\n            animation: fadeIn 0.8s ease-out forwards;\n            opacity: 0; /* Ensures element is hidden before animation starts */\n        }\n\n        @keyframes fadeInUp {\n            from { opacity: 0; transform: translateY(40px); }\n            to { opacity: 1; transform: translateY(0); }\n        }\n        .animate-fade-in-up {\n            animation: fadeInUp 1s ease-out forwards;\n            opacity: 0;\n        }\n\n        @keyframes blob {\n            0%, 100% {\n                transform: translateY(0) scale(1);\n            }\n            33% {\n                transform: translateY(-20px) translateX(20px) scale(1.1);\n            }\n            66% {\n                transform: translateY(20px) translateX(-20px) scale(0.9);\n            }\n        }\n        .animate-blob {\n            animation: blob 7s infinite cubic-bezier(0.6, 0.01, 0.2, 1);\n        }\n\n        /* Animation Delays */\n        .animation-delay-200 { animation-delay: 0.2s; }\n        .animation-delay-400 { animation-delay: 0.4s; }\n        .animation-delay-500 { animation-delay: 0.5s; }\n        .animation-delay-600 { animation-delay: 0.6s; }\n        .animation-delay-1000 { animation-delay: 1s; }\n        .animation-delay-2000 { animation-delay: 2s; }\n        .animation-delay-4000 { animation-delay: 4s; }\n    </style>\n</head>\n<body class=\"antialiased\">\n    <!-- Navbar -->\n    <header class=\"relative z-20 p-4\">\n        <nav class=\"container mx-auto flex items-center justify-between py-4 px-6 rounded-xl glass-card transition-all duration-300 hover:shadow-xl hover:border-white/20\">\n            <a href=\"#\" class=\"text-2xl font-bold gradient-text\">MyBrand</a>\n            <ul class=\"hidden md:flex space-x-8 text-lg\">\n                <li><a href=\"#\" class=\"hover:text-purple-400 transition-colors duration-200\">Features</a></li>\n                <li><a href=\"#\" class=\"hover:text-purple-400 transition-colors duration-200\">Pricing</a></li>\n                <li><a href=\"#\" class=\"hover:text-purple-400 transition-colors duration-200\">Testimonials</a></li>\n                <li><a href=\"#\" class=\"hover:text-purple-400 transition-colors duration-200\">Contact</a></li>\n            </ul>\n            <a href=\"#\" class=\"hidden md:block px-6 py-2 rounded-full gradient-button text-white font-semibold transform hover:scale-105 transition-all duration-300 shadow-lg\">Get Started</a>\n            <!-- Mobile Menu Toggle (Hamburger) -->\n            <button class=\"md:hidden text-white focus:outline-none\">\n                <svg class=\"w-8 h-8\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16m-4 6h4\"></path></svg>\n            </button>\n        </nav>\n    </header>\n\n    <!-- Hero Section -->\n    <section class=\"relative py-20 md:py-32 overflow-hidden\">\n        <!-- Background Blob/Gradient Decor -->\n        <div class=\"absolute inset-0 z-0 opacity-20\">\n            <div class=\"absolute top-1/4 left-1/4 w-96 h-96 bg-purple-500 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob\"></div>\n            <div class=\"absolute top-1/2 right-1/4 w-96 h-96 bg-blue-500 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob animation-delay-2000\"></div>\n            <div class=\"absolute bottom-1/4 left-1/3 w-96 h-96 bg-pink-500 rounded-full mix-blend-multiply filter blur-3xl opacity-30 animate-blob animation-delay-4000\"></div>\n        </div>\n\n        <div class=\"container mx-auto px-6 text-center relative z-10\">\n            <h1 class=\"text-4xl sm:text-5xl md:text-6xl font-extrabold leading-tight mb-6 animate-fade-in-up\">\n                Unlock Your Potential with <span class=\"gradient-text\">Cutting-Edge Solutions</span>\n            </h1>\n            <p class=\"text-lg md:text-xl text-gray-300 max-w-3xl mx-auto mb-10 animate-fade-in-up animation-delay-500\">\n                Experience unparalleled innovation and elevate your projects to new heights. Join a community of forward-thinkers.\n            </p>\n            <div class=\"flex flex-col md:flex-row justify-center gap-6 animate-fade-in-up animation-delay-1000\">\n                <a href=\"#\" class=\"px-8 py-4 rounded-full gradient-button text-white font-semibold text-lg transform hover:scale-105 transition-all duration-300 shadow-xl\">\n                    Get Started Free\n                </a>\n                <a href=\"#\" class=\"px-8 py-4 rounded-full bg-gray-800 text-gray-200 font-semibold text-lg border border-gray-700 hover:bg-gray-700 hover:border-purple-500 transform hover:scale-105 transition-all duration-300 shadow-lg\">\n                    Learn More &rarr;\n                </a>\n            </div>\n        </div>\n    </section>\n\n    <!-- Features Section -->\n    <section class=\"relative py-20 md:py-32 bg-gray-950\">\n        <div class=\"container mx-auto px-6 text-center\">\n            <h2 class=\"text-3xl md:text-5xl font-extrabold mb-16 animate-fade-in\">\n                Features Designed for <span class=\"gradient-text\">Your Success</span>\n            </h2>\n            <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10\">\n                <!-- Feature Card 1 -->\n                <div class=\"p-8 rounded-2xl glass-card text-left transition-all duration-300 hover:shadow-2xl hover:border-purple-400/30 transform hover:-translate-y-2 glow-hover animate-fade-in animation-delay-200\">\n                    <div class=\"text-purple-400 mb-4\">\n                        <svg class=\"w-10 h-10\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9.75 17L9 20l-1 1h8l-1-1l-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\"></path></svg>\n                    </div>\n                    <h3 class=\"text-2xl font-bold mb-4\">Intuitive Dashboard</h3>\n                    <p class=\"text-gray-300\">\n                        Effortlessly manage your projects with a beautifully designed and highly customizable interface.\n                    </p>\n                </div>\n                <!-- Feature Card 2 -->\n                <div class=\"p-8 rounded-2xl glass-card text-left transition-all duration-300 hover:shadow-2xl hover:border-blue-400/30 transform hover:-translate-y-2 glow-hover animate-fade-in animation-delay-400\">\n                    <div class=\"text-blue-400 mb-4\">\n                        <svg class=\"w-10 h-10\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M13 10V3L4 14h7v7l9-11h-7z\"></path></svg>\n                    </div>\n                    <h3 class=\"text-2xl font-bold mb-4\">Blazing Fast Performance</h3>\n                    <p class=\"text-gray-300\">\n                        Optimized for speed, our platform ensures a smooth and responsive experience for all users.\n                    </p>\n                </div>\n                <!-- Feature Card 3 -->\n                <div class=\"p-8 rounded-2xl glass-card text-left transition-all duration-300 hover:shadow-2xl hover:border-pink-400/30 transform hover:-translate-y-2 glow-hover animate-fade-in animation-delay-600\">\n                    <div class=\"text-pink-400 mb-4\">\n                        <svg class=\"w-10 h-10\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1L21 6H3l.276 10.634A2 2 0 005.275 19h13.45c1.05 0 1.905-.769 1.977-1.748L21 12v-2a2 2 0 00-2-2h-8z\"></path></svg>\n                    </div>\n                    <h3 class=\"text-2xl font-bold mb-4\">Secure & Reliable</h3>\n                    <p class=\"text-gray-300\">\n                        Your data is protected with enterprise-grade security and backed by a robust, reliable infrastructure.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Testimonials Section -->\n    <section class=\"relative py-20 md:py-32\">\n        <div class=\"container mx-auto px-6 text-center\">\n            <h2 class=\"text-3xl md:text-5xl font-extrabold mb-16 animate-fade-in\">\n                What Our Users Say <span class=\"gradient-text\">About Us</span>\n            </h2>\n            <div class=\"grid grid-cols-1 lg:grid-cols-3 gap-10\">\n                <!-- Testimonial Card 1 -->\n                <div class=\"p-8 rounded-2xl glass-card text-left transition-all duration-300 hover:shadow-2xl hover:border-white/20 transform hover:-translate-y-2 animate-fade-in animation-delay-200\">\n                    <p class=\"text-gray-300 mb-6 italic text-lg\">\n                        \"This platform has completely transformed how we approach our daily tasks. The intuitive design and powerful features are a game-changer!\"\n                    </p>\n                    <div class=\"flex items-center\">\n                        <img src=\"https://via.placeholder.com/50/600a74/ffffff?text=JD\" alt=\"John Doe\" class=\"w-12 h-12 rounded-full mr-4 border-2 border-purple-500\">\n                        <div>\n                            <p class=\"font-semibold text-lg\">John Doe</p>\n                            <p class=\"text-sm text-gray-400\">CEO, Example Corp</p>\n                        </div>\n                    </div>\n                </div>\n                <!-- Testimonial Card 2 -->\n                <div class=\"p-8 rounded-2xl glass-card text-left transition-all duration-300 hover:shadow-2xl hover:border-white/20 transform hover:-translate-y-2 animate-fade-in animation-delay-400\">\n                    <p class=\"text-gray-300 mb-6 italic text-lg\">\n                        \"The support team is incredibly responsive and knowledgeable. It's rare to find such dedication to customer satisfaction.\"\n                    </p>\n                    <div class=\"flex items-center\">\n                        <img src=\"https://via.placeholder.com/50/4b5563/ffffff?text=JS\" alt=\"Jane Smith\" class=\"w-12 h-12 rounded-full mr-4 border-2 border-blue-500\">\n                        <div>\n                            <p class=\"font-semibold text-lg\">Jane Smith</p>\n                            <p class=\"text-sm text-gray-400\">Lead Developer, Tech Innovations</p>\n                        </div>\n                    </div>\n                </div>\n                <!-- Testimonial Card 3 -->\n                <div class=\"p-8 rounded-2xl glass-card text-left transition-all duration-300 hover:shadow-2xl hover:border-white/20 transform hover:-translate-y-2 animate-fade-in animation-delay-600\">\n                    <p class=\"text-gray-300 mb-6 italic text-lg\">\n                        \"From setup to daily use, everything is seamless. My productivity has significantly increased since I started using this.\"\n                    </p>\n                    <div class=\"flex items-center\">\n                        <img src=\"https://via.placeholder.com/50/9a3412/ffffff?text=ME\" alt=\"Mike Evans\" class=\"w-12 h-12 rounded-full mr-4 border-2 border-pink-500\">\n                        <div>\n                            <p class=\"font-semibold text-lg\">Mike Evans</p>\n                            <p class=\"text-sm text-gray-400\">Marketing Director, Global Solutions</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <!-- Final CTA Section -->\n    <section class=\"relative py-20 md:py-32\">\n        <div class=\"container mx-auto px-6 text-center glass-card p-10 rounded-3xl max-w-4xl animate-fade-in animation-delay-200\">\n            <h2 class=\"text-3xl md:text-5xl font-extrabold mb-8\">\n                Ready to Get Started? <span class=\"gradient-text\">Join Today!</span>\n            </h2>\n            <p class=\"text-lg md:text-xl text-gray-300 max-w-2xl mx-auto mb-12\">\n                Sign up now and unlock a world of possibilities. No credit card required to start your free trial.\n            </p>\n            <a href=\"#\" class=\"px-10 py-5 rounded-full gradient-button text-white font-semibold text-xl transform hover:scale-105 transition-all duration-300 shadow-xl\">\n                Start Your Free Trial\n            </a>\n        </div>\n    </section>\n\n    <!-- Footer -->\n    <footer class=\"py-12 bg-gray-950 text-gray-400 text-center border-t border-gray-800\">\n        <div class=\"container mx-auto px-6\">\n            <div class=\"flex flex-col md:flex-row justify-between items-center mb-8\">\n                <a href=\"#\" class=\"text-2xl font-bold gradient-text mb-4 md:mb-0\">MyBrand</a>\n                <ul class=\"flex flex-col md:flex-row space-y-2 md:space-y-0 md:space-x-6 text-lg\">\n                    <li><a href=\"#\" class=\"hover:text-purple-400 transition-colors duration-200\">Privacy Policy</a></li>\n                    <li><a href=\"#\" class=\"hover:text-purple-400 transition-colors duration-200\">Terms of Service</a></li>\n                    <li><a href=\"#\" class=\"hover:text-purple-400 transition-colors duration-200\">Support</a></li>\n                </ul>\n            </div>\n            <p class=\"text-sm\">&copy; 2023 MyBrand. All rights reserved.</p>\n        </div>\n    </footer>\n</body>\n</html>",
